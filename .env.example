# Khóa Gemini (bắt buộc để dùng các tính năng AI).
# Lấy miễn phí tại https://aistudio.google.com/app/apikey
# Chỉ để ở máy chủ: KHÔNG thêm tiền tố VITE_ và KHÔNG đưa file .env lên GitHub.
GEMINI_API_KEY=your_gemini_api_key_here

# Tùy chọn: dùng project Supabase của riêng bạn (mặc định dùng project có sẵn trong code).
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
